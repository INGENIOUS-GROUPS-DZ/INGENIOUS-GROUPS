<style>
:root{
  --red:#e50914;
  --red2:#ff303b;
  --black:#050505;
  --dark:#0d0d0d;
  --dark2:#151515;
  --white:#fff;
  --muted:#a6a6a6;
  --line:#292929;
  --max:1200px;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,Arial,Helvetica,sans-serif;
  background:var(--black);
  color:white;
  line-height:1.55;
  overflow-x:hidden;
}

a{
  color:inherit;
  text-decoration:none;
}

img{
  max-width:100%;
  display:block;
}

.container{
  width:min(var(--max),92%);
  margin:auto;
}

/* NAVIGATION */

nav{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:1000;
  background:rgba(5,5,5,.78);
  backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(255,255,255,.08);
}

.nav{
  height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  font-size:22px;
  font-weight:950;
  letter-spacing:3px;
}

.logo span{
  color:var(--red);
}

.navlinks{
  display:flex;
  gap:28px;
  color:#ccc;
  font-size:14px;
  font-weight:700;
}

.navlinks a{
  transition:.25s;
}

.navlinks a:hover{
  color:white;
}

.lang{
  display:flex;
  gap:5px;
}

.lang button{
  border:1px solid #333;
  background:#111;
  color:#aaa;
  padding:7px 9px;
  border-radius:6px;
  cursor:pointer;
  font-weight:800;
  font-size:11px;
}

.lang button.active,
.lang button:hover{
  color:white;
  background:var(--red);
  border-color:var(--red);
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:14px 22px;
  border-radius:8px;
  font-weight:850;
  border:1px solid transparent;
  transition:.25s;
  cursor:pointer;
}

.btn-red{
  background:var(--red);
  box-shadow:0 12px 35px rgba(229,9,20,.25);
}

.btn-red:hover{
  background:var(--red2);
  transform:translateY(-2px);
}

.btn-outline{
  background:#111;
  border-color:#444;
}

.btn-outline:hover{
  border-color:#777;
}

/* HERO */

.hero{
  min-height:100vh;
  padding:145px 0 90px;
  display:flex;
  align-items:center;
  position:relative;
  isolation:isolate;
}

.hero:before{
  content:"";
  position:absolute;
  z-index:-2;
  width:700px;
  height:700px;
  right:-220px;
  top:80px;
  background:radial-gradient(
    circle,
    rgba(229,9,20,.34),
    transparent 65%
  );
  filter:blur(15px);
}

.hero:after{
  content:"";
  position:absolute;
  inset:0;
  z-index:-3;
  background:
    linear-gradient(
      125deg,
      #050505 20%,
      #0b0b0b 60%,
      #1a0305 100%
    );
}

.grid{
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:70px;
  align-items:center;
}

.eyebrow{
  display:inline-block;
  color:#ff5a63;
  border:1px solid #5d171c;
  background:#180709;
  padding:8px 13px;
  border-radius:999px;
  font-size:11px;
  font-weight:900;
  letter-spacing:1.5px;
  margin-bottom:22px;
}

h1{
  font-size:clamp(48px,7vw,90px);
  line-height:.92;
  letter-spacing:-5px;
  margin-bottom:25px;
}

h1 span{
  color:var(--red);
}

.lead{
  color:#c5c5c5;
  font-size:20px;
  max-width:670px;
  margin-bottom:32px;
}

.actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

/* HERO VISUAL */

.hero-card{
  min-height:510px;
  border:1px solid #292929;
  border-radius:30px;
  background:
    radial-gradient(
      circle at 50% 30%,
      rgba(229,9,20,.35),
      transparent 35%
    ),
    linear-gradient(145deg,#181818,#080808);
  position:relative;
  overflow:hidden;
  box-shadow:0 40px 100px rgba(0,0,0,.55);
}

.hero-card:before{
  content:"";
  position:absolute;
  width:400px;
  height:400px;
  border-radius:50%;
  background:radial-gradient(
    circle,
    #ff2733 0,
    #7e0007 30%,
    transparent 68%
  );
  top:25px;
  left:50%;
  transform:translateX(-50%);
  filter:blur(5px);
  opacity:.7;
}

.pack{
  position:absolute;
  left:50%;
  top:51%;
  transform:translate(-50%,-50%) rotate(-7deg);
  width:270px;
  height:370px;
  border-radius:27px;
  background:
    linear-gradient(
      135deg,
      #fff 0 43%,
      #d7d7d7 44% 48%,
      #111 49%
    );
  box-shadow:30px 35px 70px #000;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#111;
  text-align:center;
  font-weight:950;
  letter-spacing:3px;
  font-size:27px;
}

.pack:after{
  content:"PREMIUM\A PACKAGING";
  white-space:pre;
  position:absolute;
  bottom:45px;
  color:white;
  background:var(--red);
  padding:10px 14px;
  border-radius:4px;
  font-size:12px;
  letter-spacing:1px;
}

.float{
  position:absolute;
  padding:10px 13px;
  border:1px solid #383838;
  background:rgba(10,10,10,.8);
  backdrop-filter:blur(8px);
  border-radius:8px;
  font-size:11px;
  font-weight:900;
  z-index:3;
}

.f1{
  top:65px;
  left:35px;
}

.f2{
  right:30px;
  top:180px;
}

.f3{
  left:40px;
  bottom:75px;
}

/* SECTIONS */

section{
  padding:110px 0;
}

.section-head{
  max-width:760px;
  margin-bottom:50px;
}

.kicker{
  color:#ff4a54;
  font-weight:900;
  font-size:11px;
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:12px;
}

h2{
  font-size:clamp(34px,5vw,58px);
  line-height:1.02;
  letter-spacing:-2.5px;
  margin-bottom:17px;
}

.sub{
  color:var(--muted);
  font-size:17px;
}

/* SERVICES */

.services{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.card{
  padding:31px;
  min-height:230px;
  border:1px solid var(--line);
  border-radius:17px;
  background:linear-gradient(145deg,#121212,#090909);
  transition:.3s;
}

.card:hover{
  transform:translateY(-7px);
  border-color:#6d1a20;
  box-shadow:0 25px 60px rgba(0,0,0,.35);
}

.icon{
  width:45px;
  height:45px;
  border-radius:10px;
  background:#21090b;
  color:#ff3540;
  display:grid;
  place-items:center;
  font-size:21px;
  margin-bottom:22px;
}

.card h3{
  font-size:20px;
  margin-bottom:10px;
}

.card p{
  color:#999;
  font-size:14px;
}

/* PORTFOLIO */

.showcase{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.project{
  height:340px;
  border-radius:17px;
  overflow:hidden;
  border:1px solid #292929;
  position:relative;
  background:
    linear-gradient(145deg,#181818,#080808);
  transition:.35s;
}

.project:hover{
  transform:scale(1.02);
}

.project:nth-child(1){
  background:
    radial-gradient(
      circle at 65% 35%,
      #ff2530 0 5%,
      transparent 28%
    ),
    linear-gradient(145deg,#090909,#2a0508);
}

.project:nth-child(2){
  background:
    radial-gradient(
      circle at 40% 45%,
      #eee 0 5%,
      transparent 25%
    ),
    linear-gradient(145deg,#161616,#050505);
}

.project:nth-child(3){
  background:
    radial-gradient(
      circle at 55% 30%,
      #fff 0 4%,
      transparent 24%
    ),
    linear-gradient(145deg,#120305,#090909);
}

.project:after{
  content:"";
  position:absolute;
  inset:45% 10% 10%;
  border-radius:14px;
  background:
    linear-gradient(
      120deg,
      rgba(255,255,255,.12),
      rgba(229,9,20,.75)
    );
  transform:skewY(-6deg);
  box-shadow:0 25px 55px #000;
}

.project-label{
  position:absolute;
  z-index:3;
  left:20px;
  bottom:18px;
  font-weight:900;
}

/* OFFER */

.offer{
  border:1px solid #51151a;
  background:
    linear-gradient(120deg,#190608,#0d0d0d);
  border-radius:23px;
  padding:55px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:35px;
}

.price{
  font-size:48px;
  font-weight:950;
}

.price small{
  font-size:14px;
  color:#aaa;
  font-weight:500;
}

/* PROCESS */

.steps{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}

.step{
  border-top:2px solid #351014;
  padding-top:20px;
}

.num{
  color:#ff3943;
  font-weight:950;
  font-size:12px;
}

.step h3{
  margin:8px 0;
}

.step p{
  color:#929292;
  font-size:14px;
}

/* CONTACT */

.contact{
  background:
    linear-gradient(135deg,#e50914,#8f0007);
  border-radius:25px;
  padding:62px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:30px;
}

.contact h2{
  max-width:700px;
}

.contact p{
  color:#ffe6e7;
  margin-top:12px;
}

.contact .btn{
  background:white;
  color:#111;
}

.contact .btn:hover{
  transform:translateY(-3px);
}

/* FOOTER */

footer{
  border-top:1px solid #202020;
  padding:30px 0;
  color:#777;
  font-size:13px;
}

.foot{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

/* WHATSAPP FLOAT */

.whatsapp{
  position:fixed;
  right:22px;
  bottom:22px;
  width:58px;
  height:58px;
  border-radius:50%;
  background:#25d366;
  color:white;
  display:grid;
  place-items:center;
  font-size:25px;
  z-index:999;
  box-shadow:0 10px 30px rgba(37,211,102,.3);
  transition:.25s;
}

.whatsapp:hover{
  transform:scale(1.08);
}

/* RTL */

body.rtl{
  direction:rtl;
}

body.rtl .hero-card{
  direction:ltr;
}

body.rtl .nav,
body.rtl .contact,
body.rtl .offer{
  direction:rtl;
}

/* MOBILE */

@media(max-width:900px){

  .navlinks{
    display:none;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .hero{
    padding-top:125px;
  }

  .hero-card{
    min-height:430px;
  }

  .services,
  .showcase{
    grid-template-columns:1fr 1fr;
  }

  .steps{
    grid-template-columns:1fr 1fr;
  }

  .offer,
  .contact{
    padding:38px;
    flex-direction:column;
    align-items:flex-start;
  }
}

@media(max-width:600px){

  .nav{
    height:68px;
  }

  .logo{
    font-size:17px;
    letter-spacing:2px;
  }

  .nav > .btn{
    padding:10px 13px;
    font-size:12px;
  }

  .lang{
    display:none;
  }

  h1{
    font-size:53px;
    letter-spacing:-3px;
  }

  .lead{
    font-size:17px;
  }

  .hero-card{
    min-height:390px;
  }

  .pack{
    width:210px;
    height:290px;
    font-size:20px;
  }

  .services,
  .showcase,
  .steps{
    grid-template-columns:1fr;
  }

  .offer,
  .contact{
    border-radius:18px;
    padding:30px;
  }

  .price{
    font-size:40px;
  }

  .contact .actions{
    width:100%;
  }

  .contact .btn{
    width:100%;
  }

  .foot{
    flex-direction:column;
  }
}
</style>
</head>

